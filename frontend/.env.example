# Copy this file to .env to override the defaults.
#
# Base URL of the calculator API, without a trailing slash. Vite inlines this
# value at build time, so the dev server or the build has to be restarted after
# changing it.
#
# The default already matches a backend started with `go run ./cmd/server`.
VITE_API_BASE_URL=http://localhost:8080/api
