# Copy this file to .env to override the defaults.
#
# Both values are inlined by Vite at build time, so the dev server or the build
# has to be restarted after changing either of them.

# Base URL of the calculator API, without a trailing slash. The default already
# matches a backend started with `go run ./cmd/server`.
#
# In a deployment this is the public URL of the API, for example:
#   VITE_API_BASE_URL=https://calculator-api.onrender.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# How long the client waits for a calculation, in milliseconds. The default of
# 8000 is right for a local API. A free tier host idles its containers to sleep
# and the request that wakes one can take close to a minute, so a deployment
# should raise this:
#   VITE_REQUEST_TIMEOUT_MS=60000
VITE_REQUEST_TIMEOUT_MS=8000
